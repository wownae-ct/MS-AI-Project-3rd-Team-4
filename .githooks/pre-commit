#!/usr/bin/env bash
# 커밋 전 검증 파이프라인. 순서: ①보호 브랜치 ②충돌 마커 ③대용량 파일 ④시크릿
# ⑤백엔드 lint/format(변경분만) ⑥프론트 lint(변경분만, 툴 설치 시).
# 실무 기준: pre-commit은 "빠르게" 끝나야 한다 — 전체 테스트 스위트는 여기서 안 돌리고
# CI/pre-push 몫으로 남긴다. 여기 있는 건 전부 초 단위로 끝나는 정적 검사뿐이다.
set -eo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
fail() { echo -e "${RED}✗ 커밋 차단: $1${NC}"; exit 1; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }
ok()   { echo -e "${GREEN}✓ $1${NC}"; }

# ── ① 보호 브랜치 — main/backend/frontend에 직접 커밋 금지(README.md 브랜치 전략:
# main ← backend/frontend PR만, backend/frontend ← feature/* PR만). 급하다고
# --no-verify로 우회하는 것도 팀 합의 없이는 하지 않는다.
protected_branches="^(main|master|backend|frontend)$"
current_branch=$(git symbolic-ref --short -q HEAD || echo "HEAD")
if [[ "$current_branch" =~ $protected_branches ]]; then
  fail "'$current_branch' 브랜치에는 직접 커밋할 수 없습니다. feature/backend-*, feature/infra-*, feature/rag-* 브랜치를 만들어 backend로 PR 하거나, feature/frontend-* 브랜치를 만들어 frontend로 PR 하세요(README.md 브랜치 전략 참고)."
fi

# ── ② 병합 충돌 마커 — 해결 안 된 conflict를 실수로 커밋하는 것 방지 ──
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [[ -n "$staged_files" ]]; then
  conflict_hits=""
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    if grep -lE '^(<<<<<<<|=======$|>>>>>>>)' "$f" &> /dev/null; then
      conflict_hits+="$f"$'\n'
    fi
  done <<< "$staged_files"
  if [[ -n "$conflict_hits" ]]; then
    echo -e "${RED}다음 파일에 병합 충돌 마커가 남아 있습니다:${NC}"
    echo -n "$conflict_hits"
    fail "충돌을 해결하고 마커를 제거한 뒤 다시 커밋하세요."
  fi
fi
ok "충돌 마커 없음"

# ── ③ 대용량 파일 — 실수로 큰 바이너리/데이터 파일을 커밋하는 것 방지 ──
MAX_SIZE_KB=5120  # HARDCODED — 5MB. 정말 필요하면 팀 합의 후 --no-verify로만 우회.
if [[ -n "$staged_files" ]]; then
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    size_kb=$(( $(wc -c < "$f") / 1024 ))
    if (( size_kb > MAX_SIZE_KB )); then
      fail "'$f'(${size_kb}KB)이 ${MAX_SIZE_KB}KB를 초과합니다 — 대용량 파일은 Git LFS나 Blob Storage를 쓰세요."
    fi
  done <<< "$staged_files"
fi
ok "대용량 파일 없음(<${MAX_SIZE_KB}KB)"

# ── ④ 시크릿 스캔 — gitleaks (.gitleaks.toml 설정 사용) ──
if ! command -v gitleaks &> /dev/null; then
  warn "gitleaks가 설치되어 있지 않습니다 — 시크릿 검사를 건너뜁니다."
  warn "설치: https://github.com/gitleaks/gitleaks (winget install gitleaks 또는 scoop install gitleaks)"
else
  echo "gitleaks: 스테이징된 변경분에서 시크릿 검사 중..."
  if gitleaks protect --staged --redact --verbose; then
    ok "gitleaks: 시크릿 없음"
  else
    echo ""
    fail "gitleaks가 시크릿으로 의심되는 내용을 발견했습니다. 위 파일/라인을 확인해 제거하거나 .gitleaksignore에 예외를 등록하세요."
  fi
fi

# ── ⑤ 백엔드 Python — 스테이징된 .py 파일만 ruff check + ruff format --check ──
# 전체 저장소가 아니라 "이번 커밋에 포함된 파일만" 검사한다 — 다른 사람이 작업 중인
# 미완성 코드까지 내 커밋이 막지 않도록. uv run을 쓰는 이유: 이 프로젝트 전체가
# uv로 관리되는 venv를 전제하므로(CLAUDE.md의 backend 커맨드 전부 uv run), 로컬에
# ruff가 전역 설치돼 있는지 여부와 무관하게 항상 같은 버전으로 검사되게 하기 위함.
py_files=$(echo "$staged_files" | grep -E '^backend/.*\.py$' || true)
if [[ -n "$py_files" ]]; then
  if ! command -v uv &> /dev/null; then
    warn "uv를 찾을 수 없습니다 — Python lint/format 검사를 건너뜁니다."
  else
    rel_py_files=$(echo "$py_files" | sed 's|^backend/||')
    echo "ruff: 스테이징된 Python 파일 $(echo "$py_files" | wc -l)개 검사 중..."
    if ! (cd backend && echo "$rel_py_files" | xargs uv run --extra dev ruff check); then
      fail "ruff check 실패 — 위 오류를 고치거나 'uv run --extra dev ruff check --fix'로 자동 수정 후 다시 커밋하세요."
    fi
    if ! (cd backend && echo "$rel_py_files" | xargs uv run --extra dev ruff format --check); then
      fail "ruff format 검사 실패 — 'uv run --extra dev ruff format'으로 포맷을 맞춘 뒤 다시 커밋하세요."
    fi
    ok "ruff check + format 통과"
  fi
fi

# ── ⑥ 프론트엔드 — 스테이징된 .ts/.tsx/.js/.jsx 파일이 있으면 lint ──
# 이 시점에 frontend/package.json이 아직 없을 수 있음(스캐폴딩 전) — node_modules 체크로
# 그 경우엔 조용히 건너뛴다. lint 툴은 frontend가 정해지는 대로(예: oxlint) package.json의
# lint 스크립트가 알아서 결정하므로 여기서 특정 툴을 하드코딩하지 않는다.
fe_files=$(echo "$staged_files" | grep -E '^frontend/.*\.(ts|tsx|js|jsx)$' || true)
if [[ -n "$fe_files" ]]; then
  if [[ ! -d "frontend/node_modules" ]]; then
    warn "frontend/node_modules가 없습니다(npm install 필요) — 프론트 lint를 건너뜁니다."
  else
    echo "frontend lint: 스테이징된 프론트 파일 $(echo "$fe_files" | wc -l)개 검사 중..."
    if ! (cd frontend && npm run --silent lint); then
      fail "프론트 lint 실패 — 위 오류를 고친 뒤 다시 커밋하세요."
    fi
    ok "프론트 lint 통과"
  fi
fi

echo -e "${GREEN}모든 pre-commit 검사 통과 — 커밋 진행.${NC}"
exit 0
