{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    // lib 은 target 이 아니라 **런타임 하한**을 따라간다 — 이 저장소의 런타임 하한 단일 출처는
    // vite.config.ts 의 build.target(chrome126 · edge126 — ADR 0007 §D6 에서 chrome111 에서 올림)이다. lib 이 그보다 낮으면 브라우저에는
    // 있는 API 가 타입에 없어서, oxlint 의 unicorn(no-array-sort) 가 요구하는 toSorted() 를 쓰면
    // 린트는 통과하는데 typecheck 가 실패하는 모순이 생긴다 — 실제로 걸렸다(2026-08-22, S5 정렬).
    // ES2023 이 더 들이는 것: findLast·findLastIndex(Chrome 97) · toSorted·toReversed·toSpliced·with
    // (Chrome 110 · Edge 110 — caniuse) · WeakMap 키로서의 Symbol(108) · Intl.NumberFormat v3(106).
    // **전부 chrome126 아래**라 하한을 넘기지 않는다(하한을 올려도 이 판정은 그대로 유효하다).
    // target 은 ES2022 로 둔다 — noEmit 이라 산출에 관여하지 않고 실제 다운레벨은 build.target 이 한다.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    // 경로 별칭 — baseUrl 없이 paths만 선언한다. TypeScript 7이 baseUrl을 제거했으므로
    // 이것이 유일한 전방호환 형태다(tsconfig 파일 위치 기준 상대 해석).
    // Vite는 resolve.tsconfigPaths로 이 선언을 그대로 읽는다 — 별칭을 두 곳에 적지 않는다.
    // 설계: docs/architecture/layers.md §3
    "paths": { "@/*": ["./src/*"] },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
