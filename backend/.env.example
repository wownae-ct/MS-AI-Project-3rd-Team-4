
# Azure
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=


# Azure Key Vault 설정
KEY_VAULT_NAME=
KEY_VAULT_URL=

# Azure PostgreSQL 설정
POSTGRESQL_SERVER_NAME=
POSTGRESQL_SERVER_FQDN=
POSTGRESQL_VERSION=
POSTGRESQL_ADMIN_USERNAME=
POSTGRESQL_ADMIN_PASSWORD=
POSTGRESQL_LOCATION=
POSTGRESQL_DATABASE_NAME=

# AKS(Azure Kubernetes Service) 설정
AKS_CLUSTER_NAME=
AKS_RESOURCE_GROUP=
AKS_LOCATION=
AKS_FQDN=

STATIC_WEB_APP_NAME=
STATIC_WEB_APP_URL=
STATIC_WEB_APP_LOCATION=
STATIC_WEB_APP_SKU=

LOG_ANALYTICS_WORKSPACE_NAME=
LOG_ANALYTICS_CUSTOMER_ID=
LOG_ANALYTICS_SKU_NAME=

# Azure OpenAI 설정 — disableLocalAuth: true라 API 키 없음, Managed Identity로만 인증
AZURE_OPENAI_ENDPOINT=
# TODO(재확인): 2024-10-21은 임시 기본값 — 구현 시점에 실제 배포된 리소스/openai 패키지 버전과
# 다시 맞춰볼 것 (원래 브리프코치_기술설계서.md §8 미결 항목이었음, 문서는 docs/old/brief/plan/에
# 아카이브 — 메리맵 기술설계서에서 같은 항목 재확인 필요)
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding

# DB (backend/app/core/config.py, backend/alembic/env.py도 동일 값 사용) — 로컬 개발용
# DATABASE_URL은 비밀번호 포함 DSN, 클러스터에서는 DATABASE_AUTH_MODE=aad로 바뀌고 비밀번호 없는
# DSN + AAD 토큰을 씀
DATABASE_URL=
DATABASE_AUTH_MODE=password

# RAG 하이브리드 검색 (05_RAG_design.md §4) — 벡터 top-k + tsvector top-k → RRF 융합 → 컨텍스트 top-k
RAG_VECTOR_TOP_K=8
RAG_TSVECTOR_TOP_K=8
RAG_CONTEXT_TOP_K=5
RAG_RRF_K=60

# 소셜 로그인(구글/네이버/카카오/애플, 00_BASELINE.md §0-2 Should + 15_post_v4_scope_
# promotion.md §P1) — 각 IdP 개발자 콘솔에서 발급받은 값. 콜백 URI(OAUTH_BACKEND_BASE_URL +
# /api/v1/auth/{provider}/callback, 애플은 POST 버전)를 콘솔에 미리 등록해야 한다.
# client_secret은 절대 브라우저에 내려가지 않는다(BFF 패턴, app/services/oauth.py).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 애플: CLIENT_ID는 웹/서버용 Services ID(앱 Bundle ID 아님). PRIVATE_KEY는 "Sign in with
# Apple" 키의 PEM 원문(BEGIN/END PRIVATE KEY로 감싸인 여러 줄 텍스트) — 여러 줄이라 큰따옴표로
# 감싸고 개행을 \n으로 이스케이프해서 한 줄로 넣는다(python-dotenv가 큰따옴표 안의 \n만 실제
# 개행으로 되돌려준다). gitleaks 오탐 방지를 위해 여기엔 실제 PEM 형태 예시를 적지 않는다 —
# 값을 넣을 땐 실제 발급받은 키 원문 전체를 그대로(줄바꿈만 \n으로) 옮기면 된다.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 로컬 기본값은 app/core/config.py의 Settings 기본값과 동일 — 비워두면 그 기본값을 쓴다.
OAUTH_BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Langfuse LLM 관측/트레이싱 (14_langfuse_tracing_design.md) — 기본 off, Langfuse Cloud Japan
# 리전. 실제 키 값은 여기(.env.example)엔 절대 넣지 말 것 — backend/.env(로컬, gitignore 대상)
# 에만 채울 것.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
