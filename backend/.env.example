
# Azure
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=


# Azure Key Vault 설정
KEY_VAULT_NAME=
KEY_VAULT_URL=

# Azure PostgreSQL 설정
POSTGRESQL_SERVER_NAME=
POSTGRESQL_SERVER_FQDN=
POSTGRESQL_VERSION=
POSTGRESQL_ADMIN_USERNAME=
POSTGRESQL_ADMIN_PASSWORD=
POSTGRESQL_LOCATION=
POSTGRESQL_DATABASE_NAME=

# AKS(Azure Kubernetes Service) 설정
AKS_CLUSTER_NAME=
AKS_RESOURCE_GROUP=
AKS_LOCATION=
AKS_FQDN=

STATIC_WEB_APP_NAME=
STATIC_WEB_APP_URL=
STATIC_WEB_APP_LOCATION=
STATIC_WEB_APP_SKU=

LOG_ANALYTICS_WORKSPACE_NAME=
LOG_ANALYTICS_CUSTOMER_ID=
LOG_ANALYTICS_SKU_NAME=

# Azure OpenAI 설정 — disableLocalAuth: true라 API 키 없음, Managed Identity로만 인증
AZURE_OPENAI_ENDPOINT=
# TODO(재확인): 2024-10-21은 임시 기본값 — 구현 시점에 실제 배포된 리소스/openai 패키지 버전과
# 다시 맞춰볼 것 (브리프코치_기술설계서.md §8 미결)
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding

# RAG 파이프라인 (backend/app/core/config.py) — 로컬 개발용 DATABASE_URL은 비밀번호 포함 DSN,
# 클러스터에서는 DATABASE_AUTH_MODE=aad로 바뀌고 비밀번호 없는 DSN + AAD 토큰을 씀
DATABASE_URL=
DATABASE_AUTH_MODE=password
RAG_CORPUS_PATH=../data/rag_corpus/speech_guide_corpus.json
RAG_CHUNK_MIN_CHARS=300
RAG_CHUNK_MAX_CHARS=500
RAG_SEARCH_DEFAULT_K=5
