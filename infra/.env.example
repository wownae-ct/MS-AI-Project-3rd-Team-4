# infra/.env로 복사해서 실제 값 채우기 (infra/.env는 .gitignore 처리됨, 이 파일만 git 추적)
# scripts/deploy-infra.sh가 이 값들을 읽어서 az 배포를 한 번에 실행한다.

# 리소스 이름 프리픽스 — 팀/프로젝트 식별용(영문 소문자+숫자만, 3~12자, 예: team4aicoach는 너무 길어서
# team4ai 처럼 줄일 것). Key Vault 이름(24자 제한, -kv 접미사)이 가장 타이트한 제약이라 이 상한을 둠.
# 비워두면 scripts/deploy-infra.sh가 실행 시 직접 물어봄(대화형).
NAME_PREFIX=

# 환경 태그(dev/staging 등) — 비워두면 dev로 폴백
DEPLOY_ENVIRONMENT=

# az account set --subscription 에 쓸 구독 이름 또는 ID
AZURE_SUBSCRIPTION=

# 배포 대상 리소스그룹 이름 (az group create로 미리 만들어둬야 함, infra/README.md 배포 순서 1번 참고)
AZURE_RG=

# Postgres 관리자 로그인 아이디 (infra/bicep/params/dev.bicepparam의 POSTGRES_ADMIN_LOGIN 기본값 'pgadmin' 대신 쓸 값)
POSTGRES_ADMIN_LOGIN=

# Postgres 관리자 비밀번호 — 반드시 채울 것, 안 채우면 dev.bicepparam의 CHANGE_ME_LOCAL_ONLY로 폴백돼 배포 실패함
POSTGRES_ADMIN_PASSWORD=

# kubectl 접근용 AAD RBAC 클러스터 관리자 오브젝트 ID(쉼표구분, 이메일 아니라 GUID).
# az ad user show --id <본인이메일> --query id -o tsv 로 확인. 비워두면 az aks get-credentials --admin으로만 접근 가능.
CLUSTER_ADMIN_OBJECT_IDS=

# --- 아래는 infra/ansible/playbooks/bootstrap-cluster.yml(클러스터 컴포넌트 부트스트랩)이 읽는 값 ---
# P1(az deployment) 완료 후, `set -a && source infra/.env && set +a`로 로드하고 실행할 것.

# cert-manager ClusterIssuer(letsencrypt-nginx)에 등록할 Let's Encrypt 알림 수신 이메일
LETSENCRYPT_EMAIL=

# ArgoCD가 이 프라이빗 레포를 읽을 때 쓸 GitHub PAT (repo:read 권한만이면 충분). 로그에 남지 않도록
# 플레이북에서 no_log 처리함 — 그래도 여기 채운 값은 infra/.env가 .gitignore 처리돼 있어야 안전함(이미 처리됨).
GITHUB_PAT=

# P1 배포 출력값의 imageUpdaterIdentityClientId (ArgoCD Image Updater가 ACR을 Workload Identity로 인증할 때 씀)
IMAGE_UPDATER_IDENTITY_CLIENT_ID=

# az aks get-credentials로 생성되는 kubectl context 이름(보통 <namePrefix>-aks). 플레이북이 엉뚱한 클러스터에
# 실행되는 걸 막는 안전장치 — 비워두면 이 체크를 건너뜀.
AKS_KUBE_CONTEXT=

# P1 배포 출력값의 acrLoginServer (예: aicoachacr.azurecr.io) — ArgoCD Image Updater가 ACR을
# Workload Identity로 인증할 때(registries.conf) 씀.
ACR_LOGIN_SERVER=

# PostgreSQL DB 이름
DATABASE_NAME=

# 소셜 로그인(구글/네이버, 00_BASELINE.md §0-2 Should) — 각 IdP 개발자 콘솔에서 발급받은 값.
# 비워두면 dev.bicepparam이 CHANGE_ME_LOCAL_ONLY로 폴백(파드는 뜨지만 실제 로그인은 안 됨).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
