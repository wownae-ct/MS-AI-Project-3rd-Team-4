@description('Azure Container Registry — backend 이미지 저장소, AKS kubelet identity에 AcrPull 부여는 aks.bicep에서 처리. Basic 10GB 한도 관리용 주간 ACR Task(purge) + Log Analytics 진단 로그 연결 포함')
param location string
param namePrefix string
param tags object = {}
@allowed(['Basic', 'Standard', 'Premium'])
param sku string = 'Basic'
param logAnalyticsWorkspaceId string

@description('purge 대상 리포지토리/태그 필터 (ACR purge 문법)')
param purgeFilter string = 'backend:.*'

@description('이 기간(일)보다 오래된 이미지만 purge 후보로 고려')
param purgeAgeDays int = 14

@description('오래됐어도 최신 N개 태그는 항상 보존')
param purgeKeepCount int = 5

// 트리플쿼트('''...''')는 raw 문자열이라 ${} 보간이 안 되므로 일반 문자열 + \n으로 구성
var purgeTaskYaml = 'version: v1.1.0\nsteps:\n  - cmd: acr purge --filter "${purgeFilter}" --ago ${purgeAgeDays}d --keep ${purgeKeepCount} --untagged\n    disableWorkingDirectoryOverride: true\n    timeout: 3600\n'

resource acr 'Microsoft.ContainerRegistry/registries@2026-03-01-preview' = {
  name: replace('${namePrefix}acr', '-', '')
  location: location
  tags: tags
  sku: {
    name: sku
  }
  properties: {
    adminUserEnabled: false
    // 삭제 후 다른 구독/테넌트가 같은 레지스트리 이름의 자동생성 도메인을 재사용해 가로채는 걸(서브도메인 탈취) 원천 차단
    autoGeneratedDomainNameLabelScope: 'NoReuse'
  }
}

// Basic 10GB 스토리지 한도 관리 — 매주 일요일 00:00 UTC에 오래된/미태그 이미지 정리 (최신 purgeKeepCount개는 항상 보존)
resource purgeTask 'Microsoft.ContainerRegistry/registries/tasks@2025-03-01-preview' = {
  parent: acr
  name: 'weekly-purge-old-images'
  location: location
  tags: tags
  properties: {
    status: 'Enabled'
    platform: {
      os: 'Linux'
    }
    trigger: {
      timerTriggers: [
        {
          name: 'weekly'
          schedule: '0 0 * * 0'
        }
      ]
    }
    step: {
      type: 'EncodedTask'
      encodedTaskContent: base64(purgeTaskYaml)
    }
  }
}

resource diagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  scope: acr
  name: 'send-to-log-analytics'
  properties: {
    workspaceId: logAnalyticsWorkspaceId
    logs: [
      {
        categoryGroup: 'allLogs'
        enabled: true
      }
    ]
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}

output acrId string = acr.id
output acrName string = acr.name
output acrLoginServer string = acr.properties.loginServer
